  FORK_ROOT="$saved_fork"
  OMG_ROOT="$tmp/omg-ver"
  r=$(roster_state); case "$r" in *"0.6.8"*) : ;; *) echo "selftest roster-versie faalt ($r)"; exit 1 ;; esac
  OMG_ROOT="$tmp/omg-empty"
  r=$(roster_state); case "$r" in *"onleesbaar"*) : ;; *) echo "selftest roster-versie-leeg faalt ($r)"; exit 1 ;; esac
  OMG_ROOT="$tmp/omg-entry"
  r=$(roster_state); case "$r" in *"verwijst niet"*) : ;; *) echo "selftest roster-entry faalt ($r)"; exit 1 ;; esac
  OMG_ROOT="$tmp/omg-asset"
  r=$(roster_state); case "$r" in *"bestaat niet"*) : ;; *) echo "selftest roster-asset faalt ($r)"; exit 1 ;; esac
  OMG_ROOT="$saved_root"
  echo "SELFTEST OK"
  exit 0
}

